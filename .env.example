APP_NAME="Manager Library"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

LOG_CHANNEL=stderr
LOG_LEVEL=info

# PostgreSQL 16; the migrations create the "library" schema (ADR-001)
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=library
DB_USERNAME=library
DB_PASSWORD=

SESSION_DRIVER=array
CACHE_STORE=array
QUEUE_CONNECTION=sync

# Secrets: only in the real .env, never in the repository (Art. IX)
JWT_SECRET=
ADMIN_USERNAME=Jonas7891
ADMIN_PASSWORD=

COVERS_DIR=/app/storage/app/covers
CORS_ORIGIN=http://localhost:5173

# ADR-006: only for the demo seeder "past" phase
CLOCK_OFFSET_DAYS=0
